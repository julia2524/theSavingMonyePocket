{
  "expo": {
    "name": "theSavingMoneyPocket",
    "slug": "theSavingMoneyPocket",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.julia2524.theSavingMoneyPocket"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F8F9F7"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.CAMERA"],
      "package": "com.julia2524.theSavingMoneyPocket"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-ocr-kit",
        {
          "cameraPermission": "사진을 촬영하여 글자를 인식하는 데 사용합니다."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F8F9F7"
        }
      ],
      "expo-status-bar",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-5145202325745375~8798566813"
        }
      ]
    ]
  }
}
